{
  "expo": {
    "name": "Foco",
    "slug": "foco",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.foco.mobile",
      "entitlements": {
        "com.apple.developer.family-controls": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F1226",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.foco.mobile",
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.PACKAGE_USAGE_STATS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Para dictar notas rápidas."
        }
      ],
      "expo-localization",
      "expo-web-browser",
      [
        "expo-calendar",
        {
          "calendarPermission": "Foco junta tus calendarios en un solo sitio."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Para dictar notas rápidas.",
          "speechRecognitionPermission": "Para transcribir lo que dictas en la captura rápida."
        }
      ]
    ],
    "scheme": "foco",
    "experiments": {
      "typedRoutes": false
    }
  }
}