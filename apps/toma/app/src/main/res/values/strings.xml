    <!-- Caregiver screen -->
    <string name="cg_title">Modo cuidador</string>
    <string name="cg_intro">Si una toma sigue sin confirmarse pasado el tiempo de margen, Toma envía un aviso al móvil de la persona que cuida. No hace falta cuenta: se usa ntfy, una app gratuita y de código abierto.</string>
    <string name="cg_enable">Avisar al cuidador</string>
    <string name="cg_steps">Cómo configurarlo</string>
    <string name="cg_step_1">1. La persona que cuida instala la app ntfy (Google Play o F-Droid).</string>
    <string name="cg_step_2">2. En ntfy pulsa «+» y escribe el tema de abajo (o escanea el código QR).</string>
    <string name="cg_step_3">3. Pulsa «Enviar prueba» para comprobar que llega.</string>
    <string name="cg_topic">Tema secreto</string>
    <string name="cg_topic_note">Cualquiera que conozca este tema puede leer los avisos. Compártelo solo con quien cuida y no lo publiques.</string>
    <string name="cg_new_topic">Generar otro tema</string>
    <string name="cg_server">Servidor ntfy</string>
    <string name="cg_server_error">Debe empezar por https://</string>
    <string name="cg_include_meds">Incluir el nombre de los medicamentos</string>
    <string name="cg_include_meds_sub">Por defecto el aviso solo dice quién y a qué hora</string>
    <string name="cg_send_test">Enviar prueba</string>
    <string name="cg_test_sent">Prueba enviada</string>
    <string name="cg_qr">Código QR para suscribirse</string>
    <string name="cg_copy">Copiar</string>
    <string name="cg_copied">Copiado</string>
    <string name="cg_privacy">Al activarlo, los avisos pasan por el servidor indicado (ntfy.sh por defecto) y contienen el nombre del perfil y la hora.</string>

