    <string name="onb_title_1">Your medication, no limits</string>
    <string name="onb_body_1">As many medications as you need, free forever. No account, no ads.</string>
    <string name="onb_title_2">An alarm that insists</string>
    <string name="onb_body_2">It rings until you confirm the dose. For that, Toma needs permission to notify you and to set exact alarms.</string>
    <string name="onb_title_3">Only on your phone</string>
    <string name="onb_body_3">Your data never leaves the phone. Take it to a PDF for your doctor or to an encrypted backup.</string>
    <string name="onb_disclaimer">Toma is a reminder. It gives no medical or dosage advice and does not replace your doctor or pharmacist.</string>
