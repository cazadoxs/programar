    <string name="cg_title">Caregiver mode</string>
    <string name="cg_intro">If a dose is still unconfirmed after the grace time, Toma sends an alert to the phone of the person who cares for you. No account needed: it uses ntfy, a free and open-source app.</string>
    <string name="cg_enable">Alert the caregiver</string>
    <string name="cg_steps">How to set it up</string>
    <string name="cg_step_1">1. The caregiver installs the ntfy app (Google Play or F-Droid).</string>
    <string name="cg_step_2">2. In ntfy tap “+” and enter the topic below (or scan the QR code).</string>
    <string name="cg_step_3">3. Tap “Send test” to check that it arrives.</string>
    <string name="cg_topic">Secret topic</string>
    <string name="cg_topic_note">Anyone who knows this topic can read the alerts. Share it only with the caregiver and never post it.</string>
    <string name="cg_new_topic">Generate another topic</string>
    <string name="cg_server">ntfy server</string>
    <string name="cg_server_error">Must start with https://</string>
    <string name="cg_include_meds">Include medication names</string>
    <string name="cg_include_meds_sub">By default the alert only says who and when</string>
    <string name="cg_send_test">Send test</string>
    <string name="cg_test_sent">Test sent</string>
    <string name="cg_qr">QR code to subscribe</string>
    <string name="cg_copy">Copy</string>
    <string name="cg_copied">Copied</string>
    <string name="cg_privacy">When enabled, alerts go through the server shown (ntfy.sh by default) and contain the profile name and the time.</string>

