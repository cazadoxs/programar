{
  "rules": {
    ".read": false,
    ".write": false,

    "codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('dev').val() === auth.uid) || (data.exists() && data.child('dev').val() === auth.uid && (!newData.exists() || newData.child('dev').val() === auth.uid)))",
        ".validate": "$code.matches(/^[A-HJ-NP-Z2-9]{10}$/) && newData.hasChildren(['dev', 'expiresAt'])",
        "dev": { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "expiresAt": { ".validate": "newData.isNumber() && newData.val() <= now + 1200000" },
        "$other": { ".validate": false }
      }
    },

    "devices": {
      "$dev": {
        ".read": "auth != null && (auth.uid === $dev || data.child('members').child(auth.uid).child('status').val() === 'active')",
        ".write": "auth != null && auth.uid === $dev && !newData.exists()",

        "owner": {
          ".write": "auth != null && auth.uid === $dev",
          ".validate": "newData.val() === $dev"
        },
        "name": {
          ".write": "auth != null && auth.uid === $dev",
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "config": {
          ".write": "auth != null && (auth.uid === $dev || root.child('devices').child($dev).child('members').child(auth.uid).child('status').val() === 'active')",
          ".validate": "newData.hasChildren(['json', 'rev'])",
          "json": { ".validate": "newData.isString() && newData.val().length <= 400000" },
          "rev": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "by": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "$other": { ".validate": false }
        },
        "status": {
          ".write": "auth != null && auth.uid === $dev",
          "battery": { ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 100" },
          "charging": { ".validate": "newData.isBoolean()" },
          "lastActive": { ".validate": "newData.isNumber()" },
          "sos": { ".validate": "newData.isNumber()" },
          "lastSeen": { ".validate": "newData.isNumber() && newData.val() <= now" },
          "done": {
            "$rid": { ".validate": "$rid.matches(/^[A-Za-z0-9_-]{1,40}$/) && newData.isNumber()" }
          },
          "$other": { ".validate": false }
        },
        "pairing": {
          ".write": "auth != null && auth.uid === $dev",
          "code": { ".validate": "newData.isString() && newData.val().matches(/^[A-HJ-NP-Z2-9]{10}$/)" },
          "expiresAt": { ".validate": "newData.isNumber() && newData.val() <= now + 1200000" },
          "$other": { ".validate": false }
        },
        "members": {
          "$m": {
            ".read": "auth != null && auth.uid === $m",
            ".write": "auth != null && (auth.uid === $dev || (auth.uid === $m && !newData.exists()) || (auth.uid === $m && !data.exists() && newData.child('status').val() === 'pending' && root.child('devices').child($dev).child('pairing').child('code').val() === newData.child('code').val() && root.child('devices').child($dev).child('pairing').child('expiresAt').val() > now))",
            ".validate": "newData.hasChildren(['name', 'status'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "status": { ".validate": "newData.val() === 'pending' || newData.val() === 'active'" },
            "code": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "devices": {
          "$dev": { ".validate": "newData.isBoolean() && $dev.matches(/^[A-Za-z0-9]{10,64}$/)" }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
