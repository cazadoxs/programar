<?xml version="1.0" encoding="utf-8"?>
<!-- Back up only the favourites. Settings (which cache the Pro entitlement) are deliberately
     excluded so a restored backup can never grant Pro on another account; Play re-confirms it. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="user.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="user.db" />
    </device-transfer>
</data-extraction-rules>
