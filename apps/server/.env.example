# Postgres en producción (Neon, Railway, Supabase…). Sin definir: PGlite local en .data/foco
# DATABASE_URL=postgres://user:pass@host:5432/foco
# Mínimo 32 caracteres aleatorios (openssl rand -hex 32). En producción (NODE_ENV=production
# o PUBLIC_URL con https) el servidor no arranca con este valor de ejemplo ni sin DATABASE_URL.
JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio
# 32 bytes en base64: openssl rand -base64 32
ENCRYPTION_KEY=
PUBLIC_URL=http://localhost:8787
# Dónde está la versión web: único origen permitido por CORS y destino de vuelta de OAuth (WEB_URL/oauth)
WEB_URL=http://localhost:8081
# Pon 1 solo si el servidor está detrás de tu propio proxy (Railway, Fly, Render…): los límites de
# peticiones usarán la primera IP de X-Forwarded-For en vez de la del socket
# TRUST_PROXY=1
# Google Calendar (Google Cloud Console → Credenciales → ID de cliente OAuth, tipo Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Outlook / Microsoft 365 (Microsoft Entra → Registros de aplicaciones)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Foco Pro (Google Play). Clave JSON de una cuenta de servicio invitada en Play Console
# (Usuarios y permisos → "Ver datos financieros" y "Gestionar pedidos"), en una línea o en base64.
GOOGLE_PLAY_PACKAGE=app.foco.mobile
GOOGLE_PLAY_SERVICE_ACCOUNT=
# Solo desarrollo: acepta cualquier compra sin preguntar a Google
# BILLING_DEV_ACCEPT_ALL=1
