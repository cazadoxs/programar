    <string name="onb_welcome_title">Take back your time</string>
    <string name="onb_welcome_body">FocusGuard blocks Shorts, Reels and the TikTok feed the moment they appear, without touching your stories, chats or long-form videos.</string>
    <string name="onb_privacy_title">100% private</string>
    <string name="onb_privacy_body">Everything happens on your phone. FocusGuard has no Internet permission, sends no data anywhere, and cannot.</string>
    <string name="onb_access_title">Turn on the accessibility service</string>
    <string name="onb_access_body">FocusGuard needs this permission to recognize when Shorts or Reels content appears and close it instantly. It is the only way to block content inside other apps without root.</string>
