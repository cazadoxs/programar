    <!-- Onboarding -->
    <string name="onb_welcome_title">Recupera tu tiempo</string>
    <string name="onb_welcome_body">FocusGuard bloquea Shorts, Reels y el feed de TikTok en el momento en que aparecen, sin tocar tus historias, chats ni los videos largos.</string>
    <string name="onb_privacy_title">100% privado</string>
    <string name="onb_privacy_body">Todo ocurre en tu teléfono. FocusGuard no tiene permiso de Internet, no envía datos a ningún servidor y no puede hacerlo.</string>
    <string name="onb_access_title">Activa el servicio de accesibilidad</string>
    <string name="onb_access_body">FocusGuard necesita este permiso para reconocer cuándo aparece contenido de Shorts o Reels en pantalla y cerrarlo al instante. Es el único modo de bloquear contenido dentro de otras apps sin root.</string>
    <string name="onb_access_cta">Activar permiso</string>
